# MedAssist environment template.
# Copy to .env, fill in real values, never commit. .env is gitignored.

# ── MCP server ──────────────────────────────────────────────────────────────
MCP_SERVER_PORT=3001
# Optional platform-provided alias; if set, the MCP server also honors PORT.
# PORT=3001
LOG_LEVEL=info

# ── FHIR ────────────────────────────────────────────────────────────────────
# PHI guardrail (src/auth/phi-guard.ts) refuses to call any host outside the
# synthetic-data allowlist. Default allowlist covers hapi.fhir.org, localhost,
# and the Prompt Opinion reference test endpoints. Extend via ALLOWED_FHIR_HOSTS
# (comma-separated). Set PHI_GUARD=off to disable entirely (only for vetted
# private synthetic deployments).
FHIR_BASE_URL=http://hapi.fhir.org/baseR4
FHIR_ACCESS_TOKEN=
# ALLOWED_FHIR_HOSTS=
# PHI_GUARD=on

# ── A2A agent ───────────────────────────────────────────────────────────────
AGENT_PORT=8001
MCP_SERVER_URL=http://localhost:3001/mcp
# AGENT_PUBLIC_URL must be set when deploying publicly so the served agent
# card reports the externally reachable URL.
AGENT_PUBLIC_URL=http://localhost:8001

# Agent LLM. Read from AGENT_MODEL env so swaps don't require code edits.
# Tested-working: gemini-2.5-flash. Flash-lite tiers (preview, latest) are
# currently 503-overloaded on Google's side. Gemma names work on the API but
# require litellm in ADK; we keep the venv lean and stay on Gemini-namespace.
GOOGLE_API_KEY=
AGENT_MODEL=gemini-2.5-flash

# ── External APIs (optional - have public endpoints) ────────────────────────
OPENFDA_API_KEY=

# ── LLM-powered MCP tools (differential_diagnosis, draft_soap_note) ─────────
# Used by the OpenAI-compatible client in mcp-server/src/external/llm.ts.
# Provider precedence: NOWBIND (Azure-proxy) > direct OpenAI. When neither is
# set, the LLM tools return a configuration-error Markdown explaining how to
# configure them — they do not crash.
NOWBIND_AGENT_OPENAI_API_KEY=
NOWBIND_AGENT_OPENAI_BASE_URL=
NOWBIND_AGENT_OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
